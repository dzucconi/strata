{
  "name": "strata",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ./dist",
    "copy": "cp -r ./public/* ./dist",
    "generate": "node ./scripts/generate-content.js",
    "compile": "parcel build src/index.html",
    "build": "yarn clean && yarn generate && yarn compile && yarn copy",
    "dev": "yarn generate && parcel src/index.html --open",
    "start": "yarn dev",
    "preview": "serve --single dist"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/page": "1.11.5",
    "parcel": "1.12.4",
    "sass": "1.49.9",
    "serve": "^14.2.6",
    "typescript": "4.6.2"
  },
  "dependencies": {
    "page": "^1.11.6"
  }
}

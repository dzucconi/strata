---
import "../index.scss";

interface Props {
  title?: string;
}

const { title = "Strata" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Strata"
      href="/rss.xml"
    />
  </head>
  <body>
    <div class="Ignore" id="root"><slot /></div>
  </body>
</html>

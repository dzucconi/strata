---
import Layout from "../layouts/Layout.astro";
import { applyCacheHeaders } from "../lib/cache";
import { getContents } from "../lib/content";
import { renderIndexEntries } from "../lib/render";
import { buildSearchIndex } from "../lib/search-index";

export const prerender = false;

applyCacheHeaders(Astro.response.headers);

const contents = await getContents();
const entries = renderIndexEntries(contents);
const searchIndex = JSON.stringify(buildSearchIndex(contents)).replace(
  /</g,
  "\\u003c"
);
---

<Layout>
  <input
    id="search"
    type="search"
    placeholder="Search"
    aria-label="Search entries"
  />
  <select id="navigation">
    <option value="CREATED_AT_DESC">descending</option>
    <option value="CREATED_AT_ASC">ascending</option>
  </select>
  <div class="Ignore" id="contents"><Fragment set:html={entries} /></div>
  <script
    id="search-index"
    type="application/json"
    set:html={searchIndex}
  />
  <script src="../scripts/index-client.ts"></script>
</Layout>

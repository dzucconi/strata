---
import Layout from "../layouts/Layout.astro";
import { applyCacheHeaders } from "../lib/cache";
import { getContents } from "../lib/content";
import { renderIndexEntries } from "../lib/render";

export const prerender = false;

applyCacheHeaders(Astro.response.headers);

const contents = await getContents();
const entries = renderIndexEntries(contents);
const contentsData = JSON.stringify(contents).replace(/</g, "\\u003c");
---

<Layout>
  <div class="Search Ignore">
    <input
      id="search"
      type="search"
      placeholder="Search"
      aria-label="Search entries"
    />
  </div>
  <div class="Ignore" id="contents"><Fragment set:html={entries} /></div>
  <script
    id="contents-data"
    type="application/json"
    set:html={contentsData}
  />
  <script src="../scripts/index-client.ts"></script>
</Layout>
